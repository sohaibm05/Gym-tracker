    {
      "id": 44,
      "type": "stat",
      "title": "Memory used",
      "description": "Computed from MemAvailable, not MemFree. MemFree excludes the page cache, which Linux will hand back on demand, so it makes a healthy machine look nearly out of memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "used",
          "refId": "A",
          "instant": false,
          "range": true,
          "editorMode": "code"
