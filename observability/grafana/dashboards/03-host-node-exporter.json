          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (node_filesystem_avail_bytes{mountpoint=~\"/|/var/lib\"} / node_filesystem_size_bytes{mountpoint=~\"/|/var/lib\"})",
