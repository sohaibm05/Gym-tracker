    {
      "id": 31,
      "type": "timeseries",
      "title": "Extraction latency percentiles",
      "description": "HISTOGRAM over a 10-minute window \u2014 longer than the HTTP one because extractions are far rarer, and a 5m window would often hold too few samples to interpolate from.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gym_llm_extraction_duration_seconds_bucket[10m])))",
          "legendFormat": "p50",
          "refId": "A",
          "instant": false,
          "range": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gym_llm_extraction_duration_seconds_bucket[10m])))",
          "legendFormat": "p95",
          "refId": "B",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
