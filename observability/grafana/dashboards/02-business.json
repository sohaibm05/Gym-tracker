{
  "uid": "gym-business",
  "title": "Gym Tracker \u2014 Business metrics",
  "description": "What the product is doing, rather than how the machine is: workouts parsed and saved, sets written, drafts awaiting review, extraction quality and logins.",
  "tags": [
    "gym-tracker",
    "business",
    "assignment-1"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
